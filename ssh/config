# Machine-specific hosts live in config.local, which is not checked in.
Include ~/.ssh/config.local

Host *
  ControlMaster=auto
  ControlPath=~/.ssh/%r@%h:%p
  ControlPersist=yes

Host fasrc
  HostName=login.rc.fas.harvard.edu
  User=jgaebler
  ForwardX11=yes
  ForwardX11Trusted=yes

Host holylogin??
  HostName=%h.rc.fas.harvard.edu
  user=jgaebler
  ForwardX11=yes
  ForwardX11Trusted=yes

Host boslogin??
  HostName=%h.rc.fas.harvard.edu
  user=jgaebler
  ForwardX11=yes
  ForwardX11Trusted=yes

Host fasse
  HostName=fasselogin.rc.fas.harvard.edu
  User=jgaebler
  ForwardX11=yes
  ForwardX11Trusted=yes

Host dtn.torch.hpc.nyu.edu
  User=jdg8969
  ForwardX11=yes
  ForwardX11Trusted=yes

Host torch login.torch.hpc.nyu.edu
  User=jdg8969
  Hostname=login.torch.hpc.nyu.edu
  ForwardX11=yes
  ForwardX11Trusted=yes
  # The login address rotates across nodes with different host keys (per NYU docs).
  StrictHostKeyChecking=no
  UserKnownHostsFile=/dev/null
  LogLevel=ERROR

Host cs* cl* gr* ga* gh* gl* gb*
  User=jdg8969
  ProxyJump=torch
